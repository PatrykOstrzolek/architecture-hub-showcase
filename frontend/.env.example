# Base URL of the Sulu website front controller (no trailing slash).
SULU_BASE_URL=http://localhost:8000

# Public URL of this Next.js site (no trailing slash). Used for metadataBase,
# sitemap.xml, and robots.txt — see ADR-0015. Server-only: nothing that reads
# it runs client-side, so no NEXT_PUBLIC_ prefix.
SITE_URL=http://localhost:3000

# Default content locale used when a caller does not pass one.
SULU_DEFAULT_LOCALE=en

# Shared secret for the POST /api/revalidate on-demand cache invalidation endpoint.
# Must match NEXT_REVALIDATE_SECRET in the backend and REVALIDATE_SECRET in GitHub Secrets.
REVALIDATE_SECRET=

# Shared secret for the GET /api/preview draft-mode entry point. Must match
# PREVIEW_SECRET in the backend — see ADR-0013.
PREVIEW_SECRET=
