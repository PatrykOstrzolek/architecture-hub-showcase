#!/usr/bin/env sh

# Frontend — prettier + eslint on staged TS/TSX files
# (git always runs hooks with cwd at the repo root, so lint-staged needs to be
# run from frontend/ to resolve its locally-installed prettier/eslint instead
# of npx fetching a fresh, dependency-less copy from the registry)
(cd frontend && npx lint-staged)

# Backend — CS Fixer + PHPStan if any PHP files are staged
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.php$' || true)
if [ -n "$STAGED_PHP" ]; then
  echo "PHP files staged — running CS Fixer and PHPStan..."

  # Auto-fix code style on staged files and re-stage them
  # (PHP runs on the host via mise — see ADR-0017 — not in a Docker container;
  # Docker is only used for Postgres + Mailpit now)
  (cd backend && echo "$STAGED_PHP" | sed 's|^backend/||' | xargs vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php)
  echo "$STAGED_PHP" | xargs git add

  # Full project type-check (result cache makes this fast after the first run)
  (cd backend && vendor/bin/phpstan analyse \
    --configuration=phpstan.ci.neon --no-progress)
fi
