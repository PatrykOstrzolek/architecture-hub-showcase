GHCR_OWNER={{ ghcr_owner }}
IMAGE_TAG={{ image_tag }}

DB_DATABASE={{ vault_db_database }}
DB_USER={{ vault_db_user }}
DB_PASSWORD={{ vault_db_password }}

APP_SECRET={{ vault_app_secret }}

DEFAULT_URI={{ backend_public_uri | default('https://' ~ api_domain) }}

# Primary connects to its own compose-internal `db` service; the secondary
# has no local Postgres and reaches the primary's over the private Tailscale
# link instead. DB_BIND_ADDR is only meaningful on the primary (what the
# published Postgres port binds to — see docker-compose.prod.yml).
DB_HOST={{ 'db' if is_primary else vault_primary_tailscale_ip }}
DB_BIND_ADDR={{ vault_primary_tailscale_ip if is_primary else '' }}

NEXT_REVALIDATE_URL={{ next_revalidate_url }}
REVALIDATE_SECRET={{ vault_next_revalidate_secret }}

PREVIEW_SECRET={{ vault_preview_secret | default('') }}
