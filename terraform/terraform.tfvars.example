# Copy to terraform.tfvars (gitignored — never commit real values):
#   cp terraform.tfvars.example terraform.tfvars
#
# ssh_public_key: output of `ssh-keygen -y -f <path to the private key
# stored in the SSH_PRIVATE_KEY GitHub Secret>` — reuses the same keypair
# Ansible already uses to reach the Mikrus primary.

region           = "eu-central-1"
instance_type    = "t3.micro" # confirm with: aws ec2 describe-instance-types --filters Name=free-tier-eligible,Values=true
ssh_public_key   = "ssh-ed25519 AAAA... your-public-key"
allowed_cidr     = "0.0.0.0/0"
root_volume_size = 20
